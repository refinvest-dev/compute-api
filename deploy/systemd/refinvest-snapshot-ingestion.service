[Unit]
Description=Refinvest immutable daily snapshot publication
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=3h
StartLimitBurst=3

[Service]
Type=exec
User=refinvest
Group=refinvest
WorkingDirectory=/opt/refinvest/compute-api
EnvironmentFile=/etc/refinvest/snapshot-ingestion.env
ExecStart=/opt/refinvest/compute-api/.venv/bin/refinvest-publish-snapshot
Restart=on-failure
RestartSec=15m
TimeoutStartSec=4h
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
