# Copy to /etc/refinvest/snapshot-ingestion.env. Keep the deployed file root-owned (0600).
# Do not commit real credential values.
REFINVEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/refinvest
REFINVEST_MASSIVE_API_KEY=replace-with-secret-manager-value
REFINVEST_SNAPSHOT_STORAGE_BACKEND=s3
REFINVEST_SNAPSHOT_STORAGE_S3_BUCKET=refinvest-snapshots
REFINVEST_SNAPSHOT_STORAGE_S3_PREFIX=daily
REFINVEST_SNAPSHOT_STORAGE_S3_REGION=ap-northeast-2
REFINVEST_SNAPSHOT_START_DATE=2010-01-01
REFINVEST_US_EQUITY_OVERRIDES_PATH=/etc/refinvest/us-equity-overrides.json
