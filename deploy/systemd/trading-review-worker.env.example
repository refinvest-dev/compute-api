# Copy to /etc/refinvest/trading-review-worker.env with owner root:root and mode 0600.
# Use secret management for the real database URL and keys; never commit values.
REFINVEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/refinvest
REFINVEST_WORKER_ID=compute-trading-review-1
REFINVEST_WORKER_LEASE_SECONDS=60
REFINVEST_WORKER_HEARTBEAT_SECONDS=15
REFINVEST_WORKER_POLL_SECONDS=1
REFINVEST_TRADING_REVIEW_EXECUTION_TIMEOUT_SECONDS=600
REFINVEST_TRADING_REVIEW_TZDB_VERSION=PINNED_TZDB_VERSION
REFINVEST_TRADING_IDENTITY_KEY=REPLACE_WITH_STABLE_SECRET_AT_LEAST_32_CHARACTERS
REFINVEST_TRADING_MASKING_KEY=REPLACE_WITH_STABLE_SECRET_AT_LEAST_32_CHARACTERS
REFINVEST_TRADING_REVIEW_PAYLOAD_KEY=REPLACE_WITH_URLSAFE_BASE64_32_BYTE_KEY
REFINVEST_TRADING_REVIEW_ARTIFACT_HOSTS=core-artifacts.internal:443
REFINVEST_WORKER_METRICS_ENABLED=false
REFINVEST_WORKER_METRICS_BIND=127.0.0.1
REFINVEST_WORKER_METRICS_PORT=9103
