# Copy to /etc/refinvest/compute-api.env. Keep the deployed file root-owned (0600).
# Do not commit real credential values.
REFINVEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/refinvest
REFINVEST_INTERNAL_API_KEY=replace-with-secret-manager-value
REFINVEST_TRADING_REVIEW_PAYLOAD_KEY=REPLACE_WITH_URLSAFE_BASE64_32_BYTE_KEY
REFINVEST_TRADING_REVIEW_ACTIVE_JOB_LIMIT=20
REFINVEST_TRADING_REVIEW_CAPACITY_RETRY_AFTER_SECONDS=30
REFINVEST_TRADING_REVIEW_GRANT_RENEWAL_CUTOFF_SECONDS=3600
REFINVEST_TRADING_REVIEW_GRANT_REFRESH_WAIT_SECONDS=300
REFINVEST_TRADING_REVIEW_MAX_ATTEMPTS=3
# Optional local-only Prometheus scrape listener; leave disabled unless a local scraper is ready.
REFINVEST_API_METRICS_ENABLED=false
REFINVEST_API_METRICS_BIND=127.0.0.1
REFINVEST_API_METRICS_PORT=9101
