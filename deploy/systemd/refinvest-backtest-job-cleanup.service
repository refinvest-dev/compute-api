[Unit]
Description=Refinvest expired backtest job cleanup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=refinvest
Group=refinvest
WorkingDirectory=/opt/refinvest/compute-api
EnvironmentFile=/etc/refinvest/backtest-job-cleanup.env
ExecStart=/opt/refinvest/compute-api/.venv/bin/refinvest-cleanup-backtest-jobs
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
