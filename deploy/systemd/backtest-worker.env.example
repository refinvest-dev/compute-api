# Copy to /etc/refinvest/backtest-worker.env. Keep the deployed file root-owned (0600).
# Do not commit real credential values or AWS access keys.
REFINVEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/refinvest
REFINVEST_ENGINE_VERSION=0.1.0
REFINVEST_WORKER_ID=compute-ec2-worker-1
REFINVEST_WORKER_LEASE_SECONDS=60
REFINVEST_WORKER_HEARTBEAT_SECONDS=15
REFINVEST_WORKER_POLL_SECONDS=1
# Maximum wall-clock time for one snapshot-pinned attempt. Timeouts are terminal failures.
REFINVEST_BACKTEST_EXECUTION_TIMEOUT_SECONDS=600
# Maximum PENDING + RUNNING jobs accepted by Compute. Core owns per-user rate limits.
REFINVEST_BACKTEST_ACTIVE_JOB_LIMIT=20
REFINVEST_SNAPSHOT_STORAGE_S3_REGION=ap-northeast-2
