# Copy to /etc/refinvest/backtest-job-cleanup.env. Keep the deployed file root-owned (0600).
# Do not commit real credential values.
REFINVEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/refinvest
# Defaults are 86400 (24 hours) and 1000. Keep these values aligned with ADR-041.
REFINVEST_BACKTEST_JOB_RETENTION_SECONDS=86400
REFINVEST_BACKTEST_JOB_CLEANUP_BATCH_SIZE=1000
