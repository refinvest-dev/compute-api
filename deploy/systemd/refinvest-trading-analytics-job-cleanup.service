[Unit]
Description=Refinvest Trading Review analytics job cleanup

[Service]
Type=oneshot
User=refinvest
Group=refinvest
WorkingDirectory=/opt/refinvest/compute-api
EnvironmentFile=/etc/refinvest/trading-analytics-job-cleanup.env
ExecStart=/opt/refinvest/compute-api/.venv/bin/refinvest-cleanup-trading-analytics-jobs
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
