{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://refinvest.example/fixtures/trading-normalization/input-identity-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["specificationVersion", "inputIdentity", "canonicalJson", "canonicalUtf8Hex", "expectedSha256"],
  "properties": {
    "specificationVersion": { "const": "TRADING_INPUT_SET_HASH_V1" },
    "inputIdentity": { "$ref": "#/$defs/identity" },
    "canonicalJson": { "type": "string", "minLength": 1 },
    "canonicalUtf8Hex": { "type": "string", "pattern": "^(?:[a-f0-9]{2})+$" },
    "expectedSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["artifactId", "sha256"],
      "properties": { "artifactId": { "type": "string", "minLength": 1 }, "sha256": { "$ref": "#/$defs/sha256" } }
    },
    "normalizer": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceDialectVersionsByArtifactRole", "adapterVersion", "normalizerVersion", "canonicalSchemaVersion", "implementationDigest", "versionSetHash"],
      "properties": {
        "sourceDialectVersionsByArtifactRole": {
          "type": "object", "additionalProperties": false,
          "required": ["TRADE_HISTORY", "POSITION_HISTORY"],
          "properties": { "TRADE_HISTORY": { "type": "string", "minLength": 1 }, "POSITION_HISTORY": { "type": "string", "minLength": 1 } }
        },
        "adapterVersion": { "type": "string", "minLength": 1 },
        "normalizerVersion": { "type": "string", "minLength": 1 },
        "canonicalSchemaVersion": { "type": "string", "minLength": 1 },
        "implementationDigest": { "type": "string", "minLength": 1 },
        "versionSetHash": { "$ref": "#/$defs/sha256" }
      }
    },
    "reconstruction": {
      "type": "object", "additionalProperties": false,
      "required": ["instrumentTermsVersionByInstrument", "reconstructionPolicyVersion", "reconciliationVersion", "reviewUnitSchemaVersion", "evidenceSchemaVersion", "implementationDigest", "versionSetHash"],
      "properties": {
        "instrumentTermsVersionByInstrument": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
        "reconstructionPolicyVersion": { "type": "string", "minLength": 1 },
        "reconciliationVersion": { "type": "string", "minLength": 1 },
        "reviewUnitSchemaVersion": { "type": "string", "minLength": 1 },
        "evidenceSchemaVersion": { "type": "string", "minLength": 1 },
        "implementationDigest": { "type": "string", "minLength": 1 },
        "versionSetHash": { "$ref": "#/$defs/sha256" }
      }
    },
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["hashSpecificationVersion", "tradingBookId", "sourceImportSessionIds", "artifactsByRole", "sourceTimezone", "reviewTimezone", "declaredProduct", "declaredPositionMode", "targetVersionSet"],
      "properties": {
        "hashSpecificationVersion": { "const": "TRADING_INPUT_SET_HASH_V1" },
        "tradingBookId": { "type": "string", "minLength": 1 },
        "sourceImportSessionIds": { "type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "artifactsByRole": {
          "type": "object", "additionalProperties": false,
          "required": ["TRADE_HISTORY", "POSITION_HISTORY"],
          "properties": { "TRADE_HISTORY": { "$ref": "#/$defs/artifact" }, "POSITION_HISTORY": { "$ref": "#/$defs/artifact" } }
        },
        "sourceTimezone": { "type": "string", "minLength": 1 },
        "reviewTimezone": { "type": "string", "minLength": 1 },
        "declaredProduct": {
          "type": "object", "additionalProperties": false,
          "required": ["venue", "productFamily", "settlementAsset"],
          "properties": { "venue": { "const": "BINANCE" }, "productFamily": { "const": "LINEAR_PERPETUAL" }, "settlementAsset": { "const": "USDT" } }
        },
        "declaredPositionMode": { "const": "ONE_WAY" },
        "targetVersionSet": {
          "type": "object", "additionalProperties": false,
          "required": ["normalizer", "reconstruction", "versionSetHash"],
          "properties": { "normalizer": { "$ref": "#/$defs/normalizer" }, "reconstruction": { "$ref": "#/$defs/reconstruction" }, "versionSetHash": { "$ref": "#/$defs/sha256" } }
        }
      }
    }
  }
}
